<!-- The the overview: what the day looks like.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The dashboard: what the restaurant looks like right now. Four
     numbers, the open orders, and the shortcuts an owner reaches for.
     Every number is a derived binding - the dashboard stores nothing. -->

<import src="parts.native"/>

<template name="screen-dashboard">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Dashboard</text>
      <text foreground="text_muted">{company_label}</text>
    </row>

    <row gap="12">
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">OPEN ORDERS</text>
          <text size="display">{open_order_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TABLES BUSY</text>
          <text size="display">{occupied_table_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">ON THE MENU</text>
          <text size="display">{product_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TABLES</text>
          <text size="display">{table_count}</text>
        </column>
      </card>
    </row>

    <row gap="8">
      <button variant="primary" on-press="open_pos">New order</button>
      <button variant="secondary" on-press="open_orders">Orders</button>
      <button variant="secondary" on-press="open_tables">Dining</button>
      <spacer grow="1"/>
      <button variant="ghost" on-press="sign_out">Sign out</button>
    </row>

    <text size="lg">Everything else</text>
    <grid columns="3" gap="8">
      <for each="overview_links" key="id" as="link">
        <card padding="12" on-press="open_screen:{link.id}">
          <column gap="2">
            <text>{link.title}</text>
            <text size="sm" foreground="text_muted">{link.detail}</text>
          </column>
        </card>
      </for>
    </grid>

    <text size="lg">Recent orders</text>
    <if test="{order_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No orders yet. The kitchen board fills up as soon as the first sale lands.</text>
      </column>
    </if>
    <if test="{order_count > 0}">
      <column gap="4">
        <for each="orders" key="id" as="order">
          <row background="surface" radius="md" padding="8" gap="8" cross="center">
            <text grow="1">{order.order_no}</text>
            <use template="status-badge" code="{order.status_code}" label="{order.status_label}"/>
            <text>{currency_symbol}{fixed(order.total_minor / currency_divisor, currency_decimal_count)}</text>
          </row>
        </for>
      </column>
    </if>

    <if test="{refunds_count > 0}">
      <card padding="16" width="480">
        <column gap="6">
          <text size="lg">Refunds</text>
          <for each="refunds" key="id" as="refund">
            <row cross="center">
              <text grow="1">{refund.reason}</text>
              <text>{currency_symbol}{fixed(-refund.amount_minor / currency_divisor, currency_decimal_count)}</text>
            </row>
          </for>
        </column>
      </card>
    </if>
  </column>
</template>

<!-- The report: what the day came to. The owner opens this at the end
     of the shift and asks two questions, and they have two answers.
     What the tickets CAME TO, and what the restaurant TOOK: the gap
     between them is what the floor still holds, because an open ticket
     is billed and unbought. The drawer's own figures - how the money
     came in - are counted by the day the cash arrived, which is not the
     day the ticket was opened, and the screen says so on each block.
     An order has no accounting date of its own yet, and that is the
     trading-day policy, which is not this screen's to decide. -->

<template name="screen-reports">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Today</text>
      <button size="sm" variant="ghost" on-press="open_dashboard">Back</button>
    </row>

    <row gap="12">
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">BILLED</text>
          <text size="display">{currency_symbol}{fixed(report_net_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">ORDERS</text>
          <text size="display">{report_order_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TAX</text>
          <text size="display">{currency_symbol}{fixed(report_tax_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">DISCOUNTS</text>
          <text size="display">{currency_symbol}{fixed(report_discount_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
    </row>

    <row gap="12">
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TAKEN</text>
          <text size="display">{currency_symbol}{fixed(report_taken_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">OWED</text>
          <text size="display">{currency_symbol}{fixed(report_owed_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">REFUNDED</text>
          <text size="display">{currency_symbol}{fixed(report_refunded_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
    </row>

    <row gap="8" cross="center">
      <text size="lg">How it was paid</text>
      <text size="sm" foreground="text_muted">received today, by the day the money arrived</text>
    </row>
    <if test="{report_modes_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">Nothing has been paid for today.</text>
      </column>
    </if>
    <if test="{report_modes_count > 0}">
      <card padding="16" width="480">
        <column gap="6">
          <for each="report_modes" key="mode" as="row">
            <row cross="center">
              <text grow="1">{row.mode_label}</text>
              <text foreground="text_muted">{row.count}</text>
              <text>{currency_symbol}{fixed(row.amount_minor / currency_divisor, currency_decimal_count)}</text>
            </row>
          </for>
        </column>
      </card>
    </if>

    <row gap="8" cross="center">
      <button size="sm" variant="secondary" on-press="start_work_period">Start work period</button>
      <button size="sm" variant="secondary" on-press="end_work_period">End work period</button>
      <button size="sm" variant="secondary" on-press="export_refunds">Export refunds CSV</button>
      <button size="sm" variant="secondary" on-press="export_payments">Export payments CSV</button>
      <button size="sm" variant="secondary" on-press="export_orders">Export orders CSV</button>
      <text size="sm" foreground="text_muted">{error_text}</text>
    </row>

    <if test="{work_periods_count > 0}">
      <card padding="16">
        <column gap="6">
          <text size="lg">Work periods</text>
          <for each="work_periods" key="id" as="period">
            <row cross="center">
              <text grow="1">{period.started_at}</text>
              <text>{period.status}</text>
            </row>
          </for>
        </column>
      </card>
    </if>



    <card padding="16">
      <row gap="8" cross="end">
        <column gap="4" grow="1">
          <text size="sm" foreground="text_muted">Expense amount</text>
          <text-field text="{form_expense_amount_minor_text}" label="Amount" on-input="form_expense_amount_minor_edit"/>
        </column>
      </row>
    </card>

    <if test="{bank_accounts_count > 0}">
      <card padding="16">
        <column gap="6">
          <text size="lg">Bank accounts</text>
          <for each="bank_accounts" key="id" as="account">
            <row cross="center">
              <text grow="1">{account.name}</text>
              <text>{account.account_no}</text>
            </row>
          </for>
          <row gap="8" cross="end">
            <column gap="4" grow="1">
              <text size="sm" foreground="text_muted">Account id</text>
              <text-field text="{form_bank_account_id_buf}" label="Account id" on-input="form_bank_account_id_edit"/>
            </column>
            <column gap="4" grow="1">
              <text size="sm" foreground="text_muted">Amount</text>
              <text-field text="{form_bank_amount_minor_buf}" label="Amount" on-input="form_bank_amount_minor_edit"/>
            </column>
            <button size="sm" variant="primary" on-press="bank_deposit">Deposit</button>
            <button size="sm" variant="secondary" on-press="bank_withdrawal">Withdraw</button>
          </row>
        </column>
      </card>
    </if>

    <if test="{loyalty_members_count > 0}">
      <card padding="16">
        <column gap="6">
          <text size="lg">Loyalty members</text>
          <for each="loyalty_members" key="id" as="member">
            <row cross="center">
              <text grow="1">{member.name}</text>
              <text>{member.points}</text>
            </row>
          </for>
          <row gap="8" cross="end">
            <column gap="4" grow="1">
              <text size="sm" foreground="text_muted">Member id</text>
              <text-field text="{form_loyalty_member_id_buf}" label="Member id" on-input="form_loyalty_member_id_edit"/>
            </column>
            <column gap="4" grow="1">
              <text size="sm" foreground="text_muted">Points</text>
              <text-field text="{form_loyalty_points_buf}" label="Points" on-input="form_loyalty_points_edit"/>
            </column>
            <button size="sm" variant="primary" on-press="loyalty_earn">Earn</button>
            <button size="sm" variant="secondary" on-press="loyalty_redeem">Redeem</button>
          </row>
        </column>
      </card>
    </if>

    <if test="{refunds_count > 0}">
      <card padding="16">
        <column gap="6">
          <text size="lg">Refunds</text>
          <for each="refunds" key="id" as="refund">
            <row cross="center">
              <text grow="1">{refund.reason}</text>
              <text>{currency_symbol}{fixed(-refund.amount_minor / currency_divisor, currency_decimal_count)}</text>
            </row>
          </for>
        </column>
      </card>
    </if>
  </column>
</template>
