<!-- The the orders: the list, the ticket and what was on it.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The order list. Every order on the board, newest first, with the
     status that the kitchen is working through. The list is the model's
     live view of the `orders` table - a status change anywhere in the
     app lands here without a refresh. -->

<template name="screen-orders">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Orders</text>
      <badge>{order_count} open</badge>
      <button size="sm" variant="ghost" on-press="open_payments">Payments</button>
    </row>

    <if test="{order_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No open orders.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="orders" key="id" as="order">
          <card padding="12">
            <row gap="12" cross="center">
              <text grow="1" on-press="open_order:{order.id}">{order.order_no}</text>
              <badge>{order.status_label}</badge>
              <text foreground="text_muted">{order.type_label}</text>
              <text>{currency_symbol}{fixed(order.total_minor / currency_divisor, currency_decimal_count)}</text>
              <button size="sm" variant="secondary" disabled="{advancing}" on-press="advance_order:{order.id}">Advance</button>
              <button size="sm" variant="primary" on-press="pay_order:{order.id}">Pay</button>
            </row>
          </card>
        </for>
      </column>
    </scroll>
  </column>
</template>

<!-- One order: what was on it, what it came to, and where it is. The
     payment is taken from here - the confirmation screen is where the
     money is taken, and this screen is where the order is found. -->

<template name="screen-order-detail">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Order {selected_order_no}</text>
      <badge>{selected_order_status}</badge>
      <button size="sm" variant="ghost" on-press="open_orders">Back</button>
    </row>

    <card padding="16" width="520">
      <column gap="8">
        <row cross="center">
          <text grow="1" foreground="text_muted">{selected_order_type}</text>
          <text>{selected_order_when}</text>
        </row>
        <separator/>
        <column gap="4">
          <for each="selected_order_lines" key="id" as="line">
            <row cross="center">
              <text grow="1">{line.product_name}</text>
              <text>{line.qty}</text>
              <text>{currency_symbol}{fixed(line.unit_price_minor * line.qty / currency_divisor, currency_decimal_count)}</text>
            </row>
          </for>
        </column>
        <separator/>
        <row cross="center">
          <text grow="1" size="lg">Total</text>
          <text size="lg">{currency_symbol}{fixed(selected_order_total / currency_divisor, currency_decimal_count)}</text>
        </row>
        <row gap="8">
          <spacer grow="1"/>
          <button variant="primary" on-press="pay_selected_order">Take the payment</button>
        </row>
      </column>
    </card>

    <!-- A wrong ticket has to be cancellable before the money is
         taken. The reason is part of the record, not an optional note:
         a void that cannot say why is not an audit trail. -->

    <if test="{selected_order_can_void}">
      <card padding="16" width="520">
        <column gap="8">
          <text size="sm" foreground="text_muted">VOID THIS ORDER</text>
          <text-field
            text="{void_reason}"
            placeholder="Wrong table, customer left, ..."
            label="Reason"
            on-input="void_reason_edit"
          />
          <row gap="8">
            <spacer grow="1"/>
            <button variant="secondary" on-press="void_order:{selected_order_id}">Void order</button>
          </row>
        </column>
      </card>
    </if>
  </column>
</template>

<!-- The money the restaurant has taken. The cashier's screen takes a
     payment; this one is the owner asking what came in, and when. -->

<template name="screen-payments">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Payments</text>
      <text foreground="text_muted">{payment_count} taken</text>
    </row>

    <row gap="12">
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TAKEN</text>
          <text size="display">{currency_symbol}{fixed(payments_total_minor / currency_divisor, currency_decimal_count)}</text>
        </column>
      </card>
    </row>

    <if test="{payment_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No payments yet.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="payments" key="id" as="payment">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <column gap="2" grow="1">
              <text>{payment.order_no}</text>
              <text size="sm" foreground="text_muted">{payment.mode_label}</text>
            </column>
            <text>{currency_symbol}{fixed(payment.amount_minor / currency_divisor, currency_decimal_count)}</text>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>
