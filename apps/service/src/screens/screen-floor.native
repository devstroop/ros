<!-- The the floor: tables, reservations and the customers who come back.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The floor. A grid of tables, each one showing who is sitting at
     it. The status is a badge, not a colour: the SDK's colour
     attributes take token names, and a status-coloured tile would need
     a dynamic token the markup cannot resolve. -->

<template name="screen-tables">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Dining</text>
      <badge>{occupied_table_count} busy of {table_count}</badge>
      <button size="sm" variant="ghost" on-press="open_floor_plan">Floor plan</button>
      <button size="sm" variant="ghost" on-press="open_table_categories">Categories</button>
    </row>

    <if test="{table_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No tables yet. Add them in the setup wizard.</text>
      </column>
    </if>

    <scroll grow="1">
      <grid columns="4" gap="8">
        <for each="tables" key="id" as="table">
          <card padding="12">
            <column gap="4">
              <text size="lg">{table.name}</text>
              <badge>{table.status_label}</badge>
              <text size="sm" foreground="text_muted">{table.seats} seats</text>
            </column>
          </card>
        </for>
      </grid>
    </scroll>
  </column>
</template>

<!-- The reservations: who is coming, when, and for how many. -->

<template name="screen-reservations">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Reservations</text>
      <text foreground="text_muted">{reservation_count}</text>
    </row>

    <if test="{reservation_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No reservations.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="reservations" key="id" as="reservation">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <column gap="2" grow="1">
              <text>{reservation.name}</text>
              <text size="sm" foreground="text_muted">{reservation.guests} guests - {reservation.phone}</text>
            </column>
            <text size="sm">{time(reservation.reserved_seconds)}</text>
            <badge>{reservation.status_label}</badge>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>

<!-- The customers. A POS without customers is a POS that cannot
     remember who came back - the list is where the loyalty points
     live. -->

<template name="screen-customers">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Customers</text>
      <text foreground="text_muted">{customer_count}</text>
      <button size="sm" variant="primary" on-press="new_customer">New</button>
    </row>

    <if test="{customer_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No customers yet.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="customers" key="id" as="customer">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <column gap="2" grow="1" on-press="edit_customer:{customer.id}">
              <text>{customer.name}</text>
              <text size="sm" foreground="text_muted">{customer.phone}</text>
            </column>
            <badge>{customer.points_label}</badge>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>

<!-- The customer form: who came back. A name, a phone, an email and
     an address - the things a restaurant needs to send a receipt to
     someone, and the things it needs to remember. -->

<template name="screen-customer-form">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Customer</text>
      <button size="sm" variant="ghost" on-press="open_customers">Back</button>
    </row>

    <card padding="16" width="460">
      <column gap="8">
        <column gap="4">
          <text size="sm" foreground="text_muted">Name</text>
          <text-field
            text="{form_customer_name}"
            placeholder="Anita Sharma"
            label="Name"
            on-input="form_customer_name_edit"
          />
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">Phone</text>
          <text-field
            text="{form_customer_phone}"
            placeholder="080 4123 4567"
            label="Phone"
            on-input="form_customer_phone_edit"
          />
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">Email</text>
          <text-field
            text="{form_customer_email}"
            placeholder="anita@example.com"
            label="Email"
            on-input="form_customer_email_edit"
          />
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">Address</text>
          <text-field
            text="{form_customer_address}"
            placeholder="12 MG Road, Bengaluru"
            label="Address"
            on-input="form_customer_address_edit"
          />
        </column>
        <row gap="8">
          <spacer grow="1"/>
          <button variant="primary" on-press="save_customer">Save</button>
        </row>
      </column>
    </card>
  </column>
</template>

<!-- The categories of tables: "Main room", "Terrace", "Bar". A
     table belongs to one, and the category is what the floor is
     arranged in. -->

<template name="screen-table-categories">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Table categories</text>
      <badge>{table_category_count} categories</badge>
      <button size="sm" variant="primary" on-press="new_table_category">New</button>
      <button size="sm" variant="ghost" on-press="open_tables">Back</button>
    </row>

    <if test="{table_category_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No categories yet. The tables need somewhere to be.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="table_categories" key="id" as="category">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <text grow="1" on-press="edit_table_category:{category.id}">{category.name}</text>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>

<template name="screen-table-category-form">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Table category</text>
      <button size="sm" variant="ghost" on-press="open_table_categories">Back</button>
    </row>

    <card padding="16" width="440">
      <column gap="8">
        <column gap="4">
          <text size="sm" foreground="text_muted">Name</text>
          <text-field
            text="{form_table_category_name}"
            placeholder="Main room"
            label="Name"
            on-input="form_table_category_name_edit"
          />
        </column>
        <row gap="8">
          <spacer grow="1"/>
          <button variant="primary" on-press="save_table_category">Save</button>
        </row>
      </column>
    </card>
  </column>
</template>

<!-- The plan of the room: the tables where they stand. The positions
     are grid cells, so a table that is in the wrong place can be put
     right, and the floor is the floor and not a list. -->

<template name="screen-floor-plan">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Floor plan</text>
      <text foreground="text_muted">{table_count} tables</text>
      <button size="sm" variant="ghost" on-press="open_tables">Back</button>
    </row>

    <if test="{table_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No tables yet, so there is no plan to draw.</text>
      </column>
    </if>

    <scroll grow="1">
      <grid columns="4" gap="8">
        <for each="tables" key="id" as="table">
          <card padding="12">
            <column gap="4">
              <text size="lg">{table.name}</text>
              <badge>{table.status_label}</badge>
              <text size="sm" foreground="text_muted">{table.seats} seats</text>
            </column>
          </card>
        </for>
      </grid>
    </scroll>
  </column>
</template>
