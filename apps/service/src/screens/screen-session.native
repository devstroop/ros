<!-- The session: setting up, choosing who is using the device, and
     signing in.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The first-run setup: the one screen a fresh ADMIN installation
     shows. A service or kiosk that starts first waits for the admin's
     reference data instead (see screen-waiting). It creates the
     company, the first operator and the credential they choose - a PIN
     or a password - and it writes a starter menu and floor so the app
     is usable the moment it is set up. The button stays disabled until
     the form is complete - the model decides that, not the markup. -->

<template name="screen-setup">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Set up your restaurant</text>
    <text foreground="text_muted">This takes a minute. Everything here can be changed later.</text>

    <card padding="16" width="440">
      <column gap="8">
        <column gap="4">
          <text size="sm" foreground="text_muted">Restaurant name</text>
          <text-field
            text="{setup_company_text}"
            placeholder="e.g. Sharma Restaurant"
            label="Restaurant name"
            on-input="setup_company_edit"
          />
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">Your name</text>
          <text-field
            text="{setup_admin_text}"
            placeholder="e.g. Anita"
            label="Your name"
            on-input="setup_admin_edit"
          />
        </column>
        <row gap="8">
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">Currency code</text>
            <text-field
              text="{setup_currency_text}"
              placeholder="USD"
              label="Currency code"
              on-input="setup_currency_edit"
            />
          </column>
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">Symbol</text>
            <text-field
              text="{setup_symbol_text}"
              placeholder="$"
              label="Symbol"
              on-input="setup_symbol_edit"
            />
          </column>
        </row>
        <row gap="4" cross="center">
          <text size="sm" foreground="text_muted" grow="1">Sign in with</text>
          <for each="credential_kinds" key="id" as="kind">
            <toggle-button selected="{kind.id == setup_credential_kind_id}" on-toggle="setup_credential_kind:{kind.id}">{kind.label}</toggle-button>
          </for>
        </row>
        <row gap="8" cross="end">
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">{setup_credential_label}</text>
            <text-field
              grow="1"
              text="{setup_credential_text}"
              placeholder="{setup_credential_hint}"
              label="{setup_credential_label}"
              on-input="setup_credential_edit"
            />
          </column>
          <button size="sm" variant="ghost" icon="eye" label="{reveal_label}" on-press="toggle_reveal">{reveal_label}</button>
        </row>
        <row gap="8" cross="end">
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">Confirm {setup_credential_label}</text>
            <text-field
              grow="1"
              text="{setup_credential2_text}"
              placeholder="again"
              label="Confirm"
              on-input="setup_credential2_edit"
            />
          </column>
          <button size="sm" variant="ghost" icon="eye" label="{reveal_label}" on-press="toggle_reveal">{reveal_label}</button>
        </row>

        <if test="{setup_failed}">
          <text foreground="destructive">{setup_error_text}</text>
        </if>

        <button variant="primary" disabled="{setup_incomplete}" on-press="setup_submit">Create the restaurant</button>
        <text size="sm" foreground="text_muted">A starter menu and six tables are created with it. Edit them from the menu any time.</text>
      </column>
    </card>
  </column>
</template>

<!-- The picker: the first screen of the app. What it lists depends on
     the device. A till or a back office lists the people who work
     here, because a person is who signs in to those, and their own row
     says which half of the sign-in they will get. A kitchen board and a
     customer display list the two device modes, because those sign in
     by being the device. The choice is a message, not a route change:
     `update` moves the model and the shell redraws. -->

<template name="screen-role-picker">
  <column grow="1" gap="16" padding="32" main="center" cross="center" background="background">
    <text size="display">Restaurant OS</text>
    <text foreground="text_muted">Who is using this device?</text>

    <column gap="8" width="420">
      <if test="{show_people}">
        <for each="employees" key="id" as="employee">
          <card padding="16">
            <column gap="4" main="center">
              <text size="lg">{employee.name}</text>
              <text foreground="text_muted" wrap="true">{employee.role_label}</text>
              <row gap="8" cross="center">
                <badge>Sign in with {employee.credential_label}</badge>
                <spacer grow="1"/>
                <button variant="primary" on-press="pick_employee:{employee.id}">Sign in</button>
              </row>
            </column>
          </card>
        </for>
      </if>

      <if test="{show_device_cards}">
        <for each="device_cards" key="id" as="device">
          <card padding="16">
            <column gap="4" main="center">
              <text size="lg">{device.title}</text>
              <text foreground="text_muted" wrap="true">{device.blurb}</text>
              <row gap="8" cross="center">
                <badge>{device.kind}</badge>
                <spacer grow="1"/>
                <button variant="primary" on-press="pick_role:{device.id}" label="{device.title}">Open</button>
              </row>
            </column>
          </card>
        </for>
      </if>
    </column>
  </column>
</template>

<!-- The sign-in. A PIN is tapped on a pad and a password is typed into
     a field, because they are different acts: a code is short, numeric
     and entered in front of a queue, and a password is long, mixed and
     entered on a keyboard. Which one this person gets is not the
     screen's business - their row says so, and the row is the truth.
     Either way the screen shows a masked value and never the secret:
     the model holds it, and `update` checks it against the hash that
     one row carries. The error line comes from the model, so the view
     never decides whether a sign-in failed. -->

<template name="screen-login">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Sign in</text>
    <text foreground="text_muted">{sign_in_employee_name} - {credential_prompt}</text>

    <card padding="16" width="320">
      <column gap="8">
        <if test="{sign_in_by_pin}">
          <column gap="8">
            <column gap="4">
              <text size="sm" foreground="text_muted">Your PIN</text>
              <text size="heading">{credential_display}</text>
            </column>
            <grid columns="3" gap="6">
              <for each="pin_digits" key="id" as="digit">
                <button label="{digit.label}" on-press="credential_digit:{digit.id}">{digit.label}</button>
              </for>
              <button variant="ghost" on-press="credential_clear">Clear</button>
              <button variant="ghost" on-press="credential_back">Back</button>
            </grid>
          </column>
        </if>

        <if test="{sign_in_by_password}">
          <row gap="8" cross="end">
            <column gap="4" grow="1">
              <text size="sm" foreground="text_muted">Password</text>
              <text-field
                grow="1"
                text="{credential_display}"
                placeholder="Your password"
                label="Password"
                on-input="credential_edit"
                on-submit="submit_login"
                autofocus="true"
              />
            </column>
            <button size="sm" variant="ghost" icon="eye" label="{reveal_label}" on-press="toggle_reveal">{reveal_label}</button>
          </row>
        </if>

        <if test="{login_failed}">
          <text foreground="destructive">{login_error}</text>
        </if>
        <button variant="primary" on-press="submit_login">Sign in</button>
        <button variant="ghost" on-press="pick_role_again">Change person</button>
      </column>
    </card>
  </column>
</template>

<!-- The company's record, and the first step of the first-run
     walk-through. The quick setup asks for the name and the currency
     and nothing else; the walk-through asks where the restaurant is
     and how to reach it, because that is what an invoice needs. -->

<template name="screen-create-company">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Set up your restaurant</text>
    <text foreground="text_muted">Step one of two. You can change any of it later.</text>
    <card padding="16" width="460">
    <column gap="8">
    <column gap="4">
      <text size="sm" foreground="text_muted">Restaurant name</text>
      <text-field
        text="{setup_company_text}"
        placeholder="e.g. Sharma Restaurant"
        label="Restaurant name"
        on-input="setup_company_edit"
      />
    </column>
    <column gap="4">
      <text size="sm" foreground="text_muted">Address</text>
      <text-field
        text="{wizard_address}"
        placeholder="12 MG Road, Bengaluru"
        label="Address"
        on-input="wizard_address_edit"
      />
    </column>
    <column gap="4">
      <text size="sm" foreground="text_muted">Phone</text>
      <text-field
        text="{wizard_phone}"
        placeholder="080 4123 4567"
        label="Phone"
        on-input="wizard_phone_edit"
      />
    </column>
    <column gap="4">
      <text size="sm" foreground="text_muted">Tax number</text>
      <text-field
        text="{wizard_tax_number}"
        placeholder="29ABCDE1234F1Z5"
        label="Tax number"
        on-input="wizard_tax_edit"
      />
    </column>
    <row gap="8" cross="center">
      <column gap="4" grow="1">
        <text size="sm" foreground="text_muted">Currency code</text>
        <text-field
          text="{setup_currency_text}"
          placeholder="INR"
          label="Currency code"
          on-input="setup_currency_edit"
        />
      </column>
      <column gap="4" grow="1">
        <text size="sm" foreground="text_muted">Symbol</text>
        <text-field
          text="{setup_symbol_text}"
          placeholder="Rs"
          label="Symbol"
          on-input="setup_symbol_edit"
        />
      </column>
    </row>
    <row gap="8">
      <spacer grow="1"/>
      <button variant="ghost" on-press="wizard_quick_setup">Set up quickly instead</button>
      <button variant="primary" on-press="wizard_next">Next</button>
    </row>
    </column>
  </card>
  </column>
</template>

<!-- The first-run walk-through. Two steps: the company, and then the
     owner and their PIN. At the end one transaction writes the
     company, the operator, the installation salt, a starter menu and
     a floor - so the restaurant is either whole or it is not there. -->

<template name="screen-wizard">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Who is the owner?</text>
    <text foreground="text_muted">Step two of two. You can change any of it later.</text>

    <card padding="16" width="460">
      <column gap="8">
        <column gap="4">
          <text size="sm" foreground="text_muted">Your name</text>
          <text-field
            text="{setup_admin_text}"
            placeholder="e.g. Anita"
            label="Your name"
            on-input="setup_admin_edit"
          />
        </column>
        <row gap="4" cross="center">
          <text size="sm" foreground="text_muted" grow="1">Sign in with</text>
          <for each="credential_kinds" key="id" as="kind">
            <toggle-button selected="{kind.id == setup_credential_kind_id}" on-toggle="setup_credential_kind:{kind.id}">{kind.label}</toggle-button>
          </for>
        </row>
        <row gap="8" cross="end">
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">{setup_credential_label}</text>
            <text-field
              grow="1"
              text="{setup_credential_text}"
              placeholder="{setup_credential_hint}"
              label="{setup_credential_label}"
              on-input="setup_credential_edit"
            />
          </column>
          <button size="sm" variant="ghost" icon="eye" label="{reveal_label}" on-press="toggle_reveal">{reveal_label}</button>
        </row>
        <row gap="8" cross="end">
          <column gap="4" grow="1">
            <text size="sm" foreground="text_muted">Confirm {setup_credential_label}</text>
            <text-field
              grow="1"
              text="{setup_credential2_text}"
              placeholder="again"
              label="Confirm"
              on-input="setup_credential2_edit"
            />
          </column>
          <button size="sm" variant="ghost" icon="eye" label="{reveal_label}" on-press="toggle_reveal">{reveal_label}</button>
        </row>
        <row gap="8">
          <spacer grow="1"/>
          <button variant="ghost" on-press="wizard_back">Back</button>
          <button variant="primary" on-press="setup_submit">Create my restaurant</button>
        </row>
      </column>
    </card>

    <text size="sm" foreground="text_muted">A starter menu and six tables are created with it. Edit them from the menu any time.</text>
  </column>
</template>

<!-- The upgrade. The database was made by a newer version of Restaurant OS,
     and this version must not write to it: a write the newer app
     would understand differently is a write that spoils the data. So
     the app says so, and stops. -->

<template name="screen-upgrade">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">This database is newer than Restaurant OS</text>
    <text foreground="text_muted">It has {database_table_count} tables and this app knows {expected_table_count}.</text>
    <text foreground="text_muted">Update Restaurant OS and try again. Nothing has been written.</text>
  </column>
</template>

<!-- Waiting for the admin: a service or kiosk that starts before the
     restaurant exists. Only the admin app writes the first company, so
     this terminal waits for the reference document instead of asking
     the waiter or the cook to invent a second restaurant. -->

<template name="screen-waiting">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Waiting for the restaurant</text>
    <text foreground="text_muted">Start the admin app on the owner's device. This terminal will pick up the menu, the people and the tables automatically.</text>
    <text size="sm" foreground="text_muted">No setup is needed here.</text>
  </column>
</template>

<!-- The landing: what the app is, and which restaurant it is for.
     An owner who needs to tell a support agent what they are running
     needs one screen that says it. -->

<template name="screen-landing">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Restaurant OS</text>
    <text foreground="text_muted">{company_label}</text>
    <text size="sm" foreground="text_muted">A restaurant operating system: point of sale, kitchen display, customer display and back office.</text>
  </column>
</template>
